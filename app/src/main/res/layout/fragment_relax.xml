<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/relax_hub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingTop="24dp">

        <LinearLayout
            android:id="@+id/relax_hub_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- 品牌区：夜月昼日 + 手写体品牌 + 渐变短线 + 楷体副标题（复刻网站 .brand） -->
            <LinearLayout
                android:id="@+id/relax_brand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="6dp">

                <FrameLayout
                    android:layout_width="26dp"
                    android:layout_height="26dp">

                    <ImageView
                        android:id="@+id/brand_moon"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="@string/app_launcher_name"
                        android:src="@drawable/ic_brand_moon" />

                    <ImageView
                        android:id="@+id/brand_sun"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:alpha="0"
                        android:contentDescription="@string/app_launcher_name"
                        android:src="@drawable/ic_brand_sun" />
                </FrameLayout>

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/brand_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/app_launcher_name"
                    android:textSize="30sp" />

                <View
                    android:id="@+id/brand_line"
                    android:layout_width="48dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="12dp" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/brand_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/brand_subtitle"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- 入口卡片流（hub） -->
            <LinearLayout
                android:id="@+id/card_favorites"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_rounded"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <ImageView
                    android:id="@+id/card_favorites_icon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_folder_vector" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <org.fossify.commons.views.MyTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/relax_custom_label"
                        android:textColor="@color/relax_text_primary"
                        android:textSize="@dimen/bigger_text_size" />

                    <org.fossify.commons.views.MyTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/relax_text_secondary"
                        android:text="@string/hub_favorites_subtitle"
                        android:textSize="@dimen/smaller_text_size" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_picks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_rounded"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <ImageView
                    android:id="@+id/card_picks_icon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_sparkle_vector" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <org.fossify.commons.views.MyTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/relax_picks_label"
                        android:textColor="@color/relax_text_primary"
                        android:textSize="@dimen/bigger_text_size" />

                    <org.fossify.commons.views.MyTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/relax_text_secondary"
                        android:text="@string/hub_picks_subtitle"
                        android:textSize="@dimen/smaller_text_size" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_report"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_rounded"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <ImageView
                    android:id="@+id/card_report_icon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_report_vector" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <org.fossify.commons.views.MyTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sleep_report"
                        android:textColor="@color/relax_text_primary"
                        android:textSize="@dimen/bigger_text_size" />

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/report_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/relax_text_secondary"
                        android:text="@string/report_subtitle_empty"
                        android:textSize="@dimen/smaller_text_size" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_night_talk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_rounded"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <ImageView
                    android:id="@+id/card_night_talk_icon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_temple_vector" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <org.fossify.commons.views.MyTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/night_talk_title"
                        android:textColor="@color/relax_text_primary"
                        android:textSize="@dimen/bigger_text_size" />

                    <org.fossify.commons.views.MyTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/relax_text_secondary"
                        android:text="@string/night_talk_subtitle"
                        android:textSize="@dimen/smaller_text_size" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- section：点卡片后展开；顶栏（返回/标题/导入导出/推荐按钮/chips）固定不滚，仅列表滚动 -->
    <LinearLayout
        android:id="@+id/relax_section"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <org.fossify.commons.views.MyTextView
                android:id="@+id/relax_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:padding="10dp"
                android:text="@string/back_label"
                android:textColor="@color/color_accent"
                android:textSize="@dimen/normal_text_size" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/relax_section_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:textColor="@color/relax_text_primary"
                android:textSize="@dimen/bigger_text_size" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/relax_import_data"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:maxLines="1"
                android:padding="8dp"
                android:text="@string/relax_import_data"
                android:textColor="@color/relax_text_secondary"
                android:textSize="13sp" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/relax_export_data"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackground"
                android:maxLines="1"
                android:padding="8dp"
                android:text="@string/relax_export_data"
                android:textColor="@color/relax_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 推荐内容按钮：固定在页面上方（站主要求），不随列表滚动 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/relax_recommend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:text="@string/recommend_add"
            android:visibility="gone" />

        <HorizontalScrollView
            android:id="@+id/relax_type_chips_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/relax_type_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <ScrollView
            android:id="@+id/relax_list_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:id="@+id/relax_holder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/relax_empty_custom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:paddingTop="20dp"
                    android:text="@string/relax_empty_custom"
                    android:textSize="@dimen/normal_text_size" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/relax_add_favorite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="18dp"
                    android:text="@string/relax_add_favorite" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
