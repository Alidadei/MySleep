<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_rounded"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:layout_marginTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <!-- head：榜单序号 + 标题 + 评分/收藏 ghost 按钮（复刻网站 .card .head） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <org.fossify.commons.views.MyTextView
            android:id="@+id/relax_item_rank"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:fontFamily="monospace"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/relax_item_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/relax_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/relax_item_rate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_ghost_button"
            android:paddingStart="12dp"
            android:paddingTop="2dp"
            android:paddingEnd="12dp"
            android:paddingBottom="2dp"
            android:text="☆"
            android:textColor="@color/relax_text_primary"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- 链接失效举报（仅社区条目；已举报/多人报告染 bad 色，复刻网站 .card .dead） -->
        <org.fossify.commons.views.MyTextView
            android:id="@+id/relax_item_dead"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_ghost_button"
            android:contentDescription="@string/dead_report_tip"
            android:paddingStart="10dp"
            android:paddingTop="2dp"
            android:paddingEnd="10dp"
            android:paddingBottom="2dp"
            android:text="⚠"
            android:textColor="@color/relax_text_primary"
            android:textSize="13sp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/relax_item_fav"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_ghost_button"
            android:contentDescription="@string/relax_favorite_add"
            android:padding="7dp"
            android:src="@drawable/ic_bookmark_vector" />
    </LinearLayout>

    <org.fossify.commons.views.MyTextView
        android:id="@+id/relax_item_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/relax_text_secondary"
        android:textSize="13sp" />

    <!-- 五星行内评分（全站图腾；默认隐藏，点 ☆ 展开） -->
    <LinearLayout
        android:id="@+id/relax_item_stars"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone" />
</LinearLayout>
