<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="28dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">

    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:contentDescription="@string/app_launcher_name"
        android:src="@mipmap/ic_launcher" />

    <org.fossify.commons.views.MyTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/app_launcher_name"
        android:textColor="@color/relax_text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/about_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:alpha="0.7"
        android:textColor="@color/relax_text_secondary"
        android:textSize="13sp" />

    <org.fossify.commons.views.MyTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="@string/about_tagline"
        android:textColor="@color/color_accent"
        android:textSize="14sp" />

    <org.fossify.commons.views.MyTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="@string/about_description"
        android:textColor="@color/relax_text_secondary"
        android:textSize="13sp" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/about_project_link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:padding="6dp"
        android:text="@string/about_project_link"
        android:textColor="@color/color_accent"
        android:textSize="14sp"
        android:textStyle="bold" />

    <org.fossify.commons.views.MyTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/about_upstream_credit"
        android:textColor="@color/relax_text_secondary"
        android:textSize="11sp" />

    <org.fossify.commons.views.MyTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:text="@string/about_privacy_note"
        android:textColor="@color/relax_text_secondary"
        android:textSize="11sp" />
</LinearLayout>
