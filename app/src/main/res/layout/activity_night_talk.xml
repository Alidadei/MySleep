<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <org.fossify.commons.views.MyTextView
            android:id="@+id/night_talk_hour"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/color_accent"
            android:textSize="@dimen/bigger_text_size" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_rounded"
            android:orientation="vertical"
            android:padding="18dp">

            <org.fossify.commons.views.MyTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/night_talk_daily_label"
                android:textColor="@color/relax_text_secondary"
                android:textSize="@dimen/smaller_text_size" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/night_talk_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/relax_text_primary"
                android:textSize="@dimen/bigger_text_size" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_rounded"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="18dp">

            <org.fossify.commons.views.MyTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/night_talk_profile_label"
                android:textColor="@color/relax_text_secondary"
                android:textSize="@dimen/smaller_text_size" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/night_talk_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/relax_text_primary"
                android:textSize="@dimen/normal_text_size" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/night_talk_edit_profile"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/night_talk_edit_profile" />
        </LinearLayout>

        <org.fossify.commons.views.MyTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/night_talk_notes_label"
            android:textColor="@color/relax_text_secondary"
            android:textSize="@dimen/smaller_text_size" />

        <LinearLayout
            android:id="@+id/night_talk_notes_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/night_talk_notes_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:paddingTop="12dp"
            android:text="@string/night_talk_notes_empty"
            android:textSize="@dimen/normal_text_size" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/night_talk_add_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp"
            android:text="@string/night_talk_add_note" />

        <org.fossify.commons.views.MyTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:alpha="0.6"
            android:gravity="center"
            android:text="@string/night_talk_matching_hint"
            android:textColor="@color/relax_text_secondary"
            android:textSize="@dimen/smaller_text_size" />
    </LinearLayout>
</ScrollView>
