<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 顶部 1px 描边（夜航 line 色，代码会按时辰 tint） -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/relax_card_stroke" />
        </shape>
    </item>
    <!-- 主体：半透明 card（磨砂近似），上移 1px 露出描边 -->
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/relax_card_bg_frosted" />
        </shape>
    </item>
</layer-list>
